<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:paddingLeft="18dp" android:paddingRight="12dp"
        android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="登录验证" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="账号密码已自动填入，请完成滑块验证并点击登录" android:textColor="#CFE7FB"
                android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <TextView android:id="@+id/btn_done"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="我已登录" android:textColor="#FFFFFF" android:textSize="13sp"
            android:background="@drawable/bg_btn_primary"
            android:paddingLeft="12dp" android:paddingRight="12dp"
            android:paddingTop="7dp" android:paddingBottom="7dp"
            android:layout_marginLeft="8dp"/>
        <TextView android:id="@+id/btn_cancel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="取消" android:textColor="#DDF0FF" android:textSize="13sp"
            android:padding="8dp" android:layout_marginLeft="4dp"/>
    </LinearLayout>

    <WebView android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
